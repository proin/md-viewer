{
  "name": "markdown-viewer",
  "productName": "Markdown Viewer",
  "version": "1.3.0",
  "private": true,
  "description": "폴더에서 읽고 편집하는 마크다운 데스크톱 앱",
  "author": "Markdown Viewer",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run build && electron .",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/files.test.cjs tests/session.test.cjs && vitest run tests/markdown.test.ts",
    "test:e2e": "node tests/e2e.mjs && node tests/drop.e2e.mjs && node tests/tabs.e2e.mjs && node tests/editor.e2e.mjs",
    "package": "npm run build && electron-builder --mac dir --arm64",
    "pretest:e2e": "npm run build"
  },
  "build": {
    "appId": "net.seasonsoft.markdownviewer",
    "productName": "Markdown Viewer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ],
      "identity": null,
      "icon": "build/icon.icns"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown document",
        "role": "Viewer"
      }
    ],
    "npmRebuild": false
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dompurify": "^3.4.15",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "highlight.js": "^11.12.0",
    "jsdom": "^29.1.1",
    "katex": "^0.18.7",
    "lucide-react": "^1.44.0",
    "markdown-it": "^15.0.1",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^12.0.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "lodash-es": "^4.18.1"
  },
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  }
}
